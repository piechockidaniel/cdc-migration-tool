# Vendored frontend packages: retain runtime assets and package/license metadata.
/frontend/static/bootstrap/**
!/frontend/static/bootstrap/LICENSE
!/frontend/static/bootstrap/package.json
!/frontend/static/bootstrap/dist/
!/frontend/static/bootstrap/dist/css/
!/frontend/static/bootstrap/dist/css/bootstrap.min.css
!/frontend/static/bootstrap/dist/js/
!/frontend/static/bootstrap/dist/js/bootstrap.bundle.min.js

/frontend/static/bootstrap-icons/**
!/frontend/static/bootstrap-icons/LICENSE
!/frontend/static/bootstrap-icons/package.json
!/frontend/static/bootstrap-icons/font/
!/frontend/static/bootstrap-icons/font/bootstrap-icons.css
!/frontend/static/bootstrap-icons/font/fonts/
!/frontend/static/bootstrap-icons/font/fonts/bootstrap-icons.woff
!/frontend/static/bootstrap-icons/font/fonts/bootstrap-icons.woff2

/frontend/static/jsplumb/**
!/frontend/static/jsplumb/browser-ui/
!/frontend/static/jsplumb/browser-ui/js/
!/frontend/static/jsplumb/browser-ui/js/jsplumb.browser-ui.umd.js
!/frontend/static/jsplumb/browser-ui/LICENSE*
!/frontend/static/jsplumb/browser-ui/package.json
